<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/todoRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="2dp">

    <EditText
        android:id="@+id/todoInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:hint="@string/todo_hint"
        android:inputType="textCapSentences"
        android:maxLines="2"
        android:padding="8dp" />

    <LinearLayout
        android:id="@+id/todoActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/todoDone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/todo_done"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/brand_primary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/todoDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/todo_delete"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/accent_warm"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
