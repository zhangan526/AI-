<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/todoRow" android:background="@drawable/todo_background" android:minHeight="56dp" android:layout_marginBottom="8dp" android:paddingStart="8dp" android:paddingEnd="4dp">
    <EditText android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/todoInput" android:layout_weight="1" android:background="@android:color/transparent" android:hint="@string/todo_hint" android:contentDescription="@string/todo_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="3" android:minHeight="48dp" android:padding="8dp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/todoActions">
        <androidx.appcompat.widget.AppCompatImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/todoDone" android:src="@drawable/ic_check_line" android:contentDescription="@string/todo_done" android:background="?attr/selectableItemBackgroundBorderless" android:padding="13dp" app:tint="@color/brand_primary" app:backgroundTint="@null" />
        <androidx.appcompat.widget.AppCompatImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/todoDelete" android:src="@drawable/ic_trash_line" android:contentDescription="@string/todo_delete" android:background="?attr/selectableItemBackgroundBorderless" android:padding="13dp" app:tint="@color/text_secondary" app:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>